# local PostGres environment variables 
POSTGRES_DB=smart_campus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=replace-with-actual-database-password

# database address used by containers
POSTGRES_HOST=db
POSTGRES_PORT=5432

# AI / RAG configuration
HF_TOKEN=your_huggingface_token
RAG_ENABLED=true

# ports used on the host
DB_HOST_PORT=5432
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Auth
#   generate locally using "openssl rand -hex 32"
JWT_KEY=your_jwt_signing_key


# College Scorecard
SCORECARD_API_KEY=

# mailjet transactional email
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM=

# keys: College Scorecard institution IDs
INSTITUTION_EMAIL_DOMAINS={}